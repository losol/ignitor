meta {
  name: Create Practitioner (invalid gender code)
  type: http
  seq: 2
}

post {
  url: {{fhirBase}}/Practitioner
  body: json
  auth: inherit
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Practitioner",
    "name": [
      {
        "family": "Hansen"
      }
    ],
    "gender": "doctor"
  }
}

assert {
  res.status: eq 400
  res.body.resourceType: eq OperationOutcome
}

docs {
  `gender` must be a code from `AdministrativeGender`. Expect `400` with an
  issue at `expression: ["Practitioner.gender"]`.
}
