meta {
  name: Create Patient (valid)
  type: http
  seq: 1
}

post {
  url: {{fhirBase}}/Patient
  body: json
  auth: inherit
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Patient",
    "name": [
      {
        "family": "Losen",
        "given": ["Skodde"]
      }
    ],
    "gender": "female",
    "birthDate": "1980-01-01",
    "active": true
  }
}

assert {
  res.status: eq 201
  res.body.resourceType: eq Patient
}

script:post-response {
  // Stash the new id so the update examples can reuse it.
  if (res.body && res.body.id) {
    bru.setVar("patientId", res.body.id);
  }
}

docs {
  Baseline happy path: `201 Created` with the stored resource (server-assigned
  `id`, `meta.versionId`). Saves `patientId` for the update examples.
}
