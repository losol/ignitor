meta {
  name: Update Patient (invalid gender code)
  type: http
  seq: 7
}

put {
  url: {{fhirBase}}/Patient/{{patientId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Patient",
    "id": "{{patientId}}",
    "gender": "bogus"
  }
}

assert {
  res.status: eq 400
  res.body.resourceType: eq OperationOutcome
}

docs {
  Same per-element `OperationOutcome` behaviour on `update` as on `create`.
  Run **Create Patient (valid)** first so `patientId` is set.
}
