meta {
  name: Search Observations for patient
  type: http
  seq: 4
}

get {
  url: {{fhirBase}}/Observation?subject=Patient/{{patientId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.resourceType: eq Bundle
}

docs {
  All observations for the patient created in **Patient → Create Patient
  (valid)**. Expect `200` with a `searchset` `Bundle`.
}
