meta {
  name: Everything (instance)
  type: http
  seq: 1
}

get {
  url: {{fhirBase}}/Patient/{{patientId}}/$everything
  body: none
  auth: inherit
}

docs {
  `$everything` — returns a `Bundle` of resources related to the patient instance.
  Uses the `patientId` runtime variable from **Create Patient**. No special scope
  required (authenticated user is enough).
}
